{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "escalate-my-api",
  "main": "../../apps/api/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "escalate-my-db",
      "database_id": "212fc43f-cb85-4bd9-87f0-695b3296e761",
      "migrations_dir": "../migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG",
      "id": "dafe3aaa649b4b2f9358ad5f0e78ade6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPORTS",
      "bucket_name": "escalate-my-reports"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "INCIDENT_ROOM", "class_name": "IncidentRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["IncidentRoom"] }
  ],
  "vars": {
    "APP_NAME": "Escalate MY",
    "API_VERSION": "v1"
  },
  "triggers": {
    "crons": ["*/30 * * * *", "*/5 * * * *"]
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}
