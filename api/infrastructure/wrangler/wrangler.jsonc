{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "escalate-my-api",
  "main": "../../apps/api/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "escalate-my-db",
      "database_id": "212fc43f-cb85-4bd9-87f0-695b3296e761",
      "migrations_dir": "../migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG",
      "id": "dafe3aaa649b4b2f9358ad5f0e78ade6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPORTS",
      "bucket_name": "escalate-my-reports"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "INCIDENT_ROOM", "class_name": "IncidentRoom" }
    ]
  },
  // Powers AI-assisted holding-statement drafting (api/packages/incidents/src/holding.ts).
  // Always has a deterministic template fallback — this binding is additive, not required.
  "ai": {
    "binding": "AI"
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["IncidentRoom"] }
  ],
  "vars": {
    "APP_NAME": "Escalate MY",
    "API_VERSION": "v1",
    // Routes the holding-statement Workers AI call (holding.ts) through AI
    // Gateway for logging/analytics/caching. "default" auto-creates on
    // first authenticated request — no account-side setup required.
    "AI_GATEWAY_ID": "default"
  },
  // Simulates a Cloudflare Access-verified identity for `wrangler dev` only —
  // this block is never read in production. There, `ctx.access` is populated
  // for real once Access is enabled on this Worker's route (Workers & Pages
  // dashboard -> escalate-my-api -> Settings -> Domains & Routes -> Enable
  // Cloudflare Access), with an identity provider and Allow policy configured
  // under Zero Trust -> Access. See api/apps/api/src/../../packages/shared/src/identity.ts.
  "access": {
    "dev": {
      "aud": "escalate-my-api-dev",
      "identity": {
        "email": "dev@escalate.my",
        "name": "Local Developer"
      }
    }
  },
  "triggers": {
    "crons": ["*/30 * * * *", "*/5 * * * *"]
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}
